# ── Suno 接入方式 ──────────────────────────────────────────────
# mock   → 立即返回固定 MP3（演示/开发用）
# browser → Keep-Alive + Android UA 直接调 API
# goapi  → GoAPI 商业代理（需要填 GOAPI_KEY）
SUNO_PROVIDER=mock

# GoAPI key（SUNO_PROVIDER=goapi 时需要）
GOAPI_KEY=

# ── JWT ────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── 数据库 ─────────────────────────────────────────────────────
DATABASE_URL=./aegis_demo.db
